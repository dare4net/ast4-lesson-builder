                    "props": {
                        "questions": [
                            {
                                "id": "q1",
                                "question": "Which sentence projects the strongest authority in a debate essay?",
                                "options": [
                                    {
                                        "id": "o1",
                                        "text": "The government could consider funding youth centers.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "o2",
                                        "text": "The government must fund youth centers immediately.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "o3",
                                        "text": "The government might try to fund youth centers.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "o4",
                                        "text": "The government may think about funding youth centers.",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "'Must' establishes an urgent, non-negotiable moral claim."
                            },
                            {
                                "id": "q2",
                                "question": "Why do skilled writers use 'may' or 'might' when introducing counter-arguments?",
                                "options": [
                                    {
                                        "id": "o1",
                                        "text": "To sound unconfident about their own position.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "o2",
                                        "text": "To acknowledge opponents' views respectfully without agreeing they are true.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "o3",
                                        "text": "Because they forgot which modal verb to use.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "o4",
                                        "text": "To make the essay longer.",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "Low-certainty modals like 'may' or 'might' allow writers to mention counterpoints while keeping their main argument strong."
