            "title": "Introduction: The 'Past of the Past'",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-1-1",
                    "type": "heading",
                    "props": {
                        "content": "🕰️ The Past Perfect: Layering the Past",
                        "level": 1,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-1-1",
                    "type": "paragraph",
                    "props": {
                        "content": "When narrating events in the past, we often need to explain that one action happened <strong>before another past action</strong>. The earlier event takes the <strong>Past Perfect Tense</strong>. Formula: <strong>HAD + PAST PARTICIPLE</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "poll-1-1",
                    "type": "poll",
                    "props": {
                        "question": "Which action happened FIRST in time?",
