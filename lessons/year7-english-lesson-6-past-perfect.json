        {
            "id": "slide-2",
            "title": "Forming the Past Perfect: HAD + V3",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-2-1",
                    "type": "heading",
                    "props": {
                        "content": "⚙️ Structure & Uniform Auxiliary HAD",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Unlike the Present Perfect (which splits between <em>has</em> and <em>have</em>), the Past Perfect is refreshingly simple: <strong>HAD</strong> is used for ALL subjects (<em>I, you, he, she, it, we, they</em>) followed by the <strong>Past Participle (V3)</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "table-2-1",
                    "type": "table",
                    "props": {
                        "rows": 4,
                        "columns": 3,
                        "data": [
                            [
                                "Subject",
                                "Auxiliary Verb",
                                "Past Participle + Complement"
                            ],
                            [
                                "I / You / He / She",
                                "HAD",
                                "had left the laboratory."
                            ],
                            [
                                "We / They / Students",
                                "HAD",
                                "had locked the gates."
                            ],
                            [
                                "The Scientists",
                                "HAD",
                                "had discovered the anomaly."
                            ]
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
