            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-4-1",
                    "type": "heading",
                    "props": {
                        "content": "💡 Demystifying 'HAD HAD' in English",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-4-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Students often think seeing <strong>HAD HAD</strong> in a sentence is a typo. It is actually 100% correct! The first <em>had</em> is the auxiliary helping verb; the second <em>had</em> is the V3 past participle of the verb <em>to have</em> (meaning possess, eat, or experience).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "table-4-1",
                    "type": "table",
                    "props": {
                        "rows": 3,
                        "columns": 3,
                        "data": [
                            [
                                "Verb Meaning",
                                "Past Perfect Construction",
                                "Example Sentence"
                            ],
                            [
                                "Possession",
                                "had (auxiliary) + had (V3)",
                                "She had had the bicycle for years before selling it."
                            ],
                            [
                                "Eating / Meals",
                                "had (auxiliary) + had (V3)",
                                "They had had breakfast before setting off at dawn."
                            ]
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
