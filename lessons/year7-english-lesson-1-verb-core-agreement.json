        {
            "id": "slide-6",
            "title": "Pronoun Agreement in Present Tense",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-6-1",
                    "type": "heading",
                    "props": {
                        "content": "👥 Matching Verbs with Pronouns",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-6-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Pronouns replace specific nouns in sentences. In the present tense, third-person singular pronouns (<em>He, She, It</em>) take singular verbs ending in <strong>-s</strong>. First-person, second-person, and third-person plural pronouns (<em>I, You, We, They</em>) take the base verb form without -s.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "matchingPairs-6-1",
