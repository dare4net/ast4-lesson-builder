        {
            "id": "slide-7",
            "title": "The Intervening Phrase Trap",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-7-1",
                    "type": "heading",
                    "props": {
                        "content": "⚠️ Beware of Intervening Prepositional Phrases",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-7-1",
                    "type": "paragraph",
                    "props": {
                        "content": "One of the most common grammar traps occurs when descriptive words get placed between the subject and the verb. Always locate the true subject of the sentence and ignore the intervening phrase!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "table-7-1",
                    "type": "table",
                    "props": {
