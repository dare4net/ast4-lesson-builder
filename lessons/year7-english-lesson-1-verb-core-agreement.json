                                "Example Sentence",
                                "Intervening Phrase (Ignore)",
                                "True Subject and Correct Verb"
                            ],
                            [
                                "The box of historical maps is on the desk.",
                                "of historical maps",
                                "Subject: 'box' (singular) -> Verb: 'is'"
                            ],
                            [
                                "The towers near the harbor stand tall.",
                                "near the harbor",
                                "Subject: 'towers' (plural) -> Verb: 'stand'"
                            ]
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
