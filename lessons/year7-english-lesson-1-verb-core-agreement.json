        {
            "id": "slide-5",
            "title": "The Golden Rule of Subject-Verb Agreement",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-5-1",
                    "type": "heading",
                    "props": {
                        "content": "⚖️ Subject-Verb Agreement: The Balance Scale",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-5-1",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Subject-Verb Agreement</strong> is the foundational grammatical rule requiring a verb to match the number of its subject. Think of it as a two-sided balance scale: if the subject side is singular, the verb side must match in singular form.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "bulletList-5-1",
                    "type": "bulletList",
                    "props": {
                        "items": [
                            "Singular Subject → Singular Verb (adds -s / -es in present tense): 'The researcher discovers new evidence.'",
                            "Plural Subject → Plural Verb (no -s in present tense): 'The researchers discover new evidence.'",
                            "Remember: Adding an -s to a noun makes it plural (book → books), but adding -s to a present-tense verb makes it singular (reads)!"
                        ],
                        "type": "unordered"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "quiz-5-1",
                    "type": "quiz",
                    "props": {
                        "questions": [
                            {
                                "id": "q1",
                                "question": "Which sentence follows correct Subject-Verb Agreement?",
                                "options": [
                                    {
                                        "id": "opt1",
                                        "text": "The student write a detailed essay.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt2",
                                        "text": "The student writes a detailed essay.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "opt3",
                                        "text": "The students writes a detailed essay.",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "'Student' is a singular subject, so it requires the singular present verb 'writes'."
                            }
                        ],
                        "showExplanation": true,
