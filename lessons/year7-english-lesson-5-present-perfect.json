    "updatedAt": "2026-08-03T15:20:00.000Z",
    "slides": [
        {
            "id": "slide-1",
            "title": "Introduction: What is the Present Perfect Tense?",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-1-1",
                    "type": "heading",
                    "props": {
                        "content": "🔗 The Present Perfect: Connecting Past and Present",
                        "level": 1,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-1-1",
                    "type": "paragraph",
                    "props": {
                        "content": "The <strong>Present Perfect Tense</strong> connects a past action or experience to the current moment. We use it when the exact time of the action is unspecified, or when a past event has direct consequences right now. Formula: <strong>HAS / HAVE + PAST PARTICIPLE</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "poll-1-1",
                    "type": "poll",
                    "props": {
                        "question": "Which sentence highlights a past life experience connected to the present?",
                        "options": [
                            {
                                "id": "opt1",
                                "text": "I have visited the Natural History Museum twice."
                            },
                            {
                                "id": "opt2",
                                "text": "I visited the Natural History Museum last Tuesday."
                            },
                            {
                                "id": "opt3",
                                "text": "I visit the Natural History Museum every winter."
                            }
                        ],
                        "points": 5,
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-1-2",
                    "type": "paragraph",
                    "props": {
                        "content": "Compare: <em>'I lost my keys'</em> (Simple Past: happened in the past) vs. <em>'I have lost my keys'</em> (Present Perfect: I still don't have them right now!).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "matchingPairs-1-1",
                    "type": "matchingPairs",
