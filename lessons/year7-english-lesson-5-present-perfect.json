        {
            "id": "slide-3",
            "title": "Signal Words: FOR vs. SINCE",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-3-1",
                    "type": "heading",
                    "props": {
                        "content": "📍 Time Signal Markers: FOR vs. SINCE",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-3-1",
                    "type": "paragraph",
                    "props": {
                        "content": "We use <strong>FOR</strong> to state the total <em>duration</em> of time. We use <strong>SINCE</strong> to mark the specific <em>starting point</em> in time.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-3-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Flip cards to compare FOR vs. SINCE usage!",
                        "cards": [
                            {
                                "id": "fc1",
                                "front": "FOR + Duration / Length of Time",
                                "back": "Examples: 'for three hours', 'for five years', 'for a decade'."
                            },
                            {
                                "id": "fc2",
                                "front": "SINCE + Specific Starting Point",
                                "back": "Examples: 'since 8:00 AM', 'since 2021', 'since last Monday'."
                            },
                            {
                                "id": "fc3",
                                "front": "FOR vs. SINCE Example",
                                "back": "'I have lived in London FOR 4 years' (duration) vs 'I have lived in London SINCE 2022' (start date)."
                            }
                        ],
                        "mode": "practice",
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
