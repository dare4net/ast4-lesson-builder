{
    "id": "year7-english-lesson-5-present-perfect",
    "title": "Lesson 5: Present Perfect Tense – Connecting Past Actions to the Present",
    "description": "Master the Present Perfect tense using has/have + past participle, differentiate specified vs unspecified time, and utilize signal words like for, since, already, yet, and just.",
    "author": "AST English Academy",
    "level": "Year 7 / KS3",
    "duration": 30,
    "settings": {
        "theme": "educational",
