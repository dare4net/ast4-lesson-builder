                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-4-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Three key adverbs add temporal nuance to Present Perfect sentences: <strong>ALREADY</strong> (sooner than expected), <strong>JUST</strong> (a short moment ago), and <strong>YET</strong> (expected, used in negative sentences and questions).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
