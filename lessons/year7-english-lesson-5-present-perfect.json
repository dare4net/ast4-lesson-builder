        {
            "id": "slide-5",
            "title": "Present Perfect vs. Simple Past Distinction",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-5-1",
                    "type": "heading",
                    "props": {
                        "content": "⚖️ Unspecified vs. Specified Past Time",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-5-1",
                    "type": "paragraph",
                    "props": {
                        "content": "The most common grammatical error in English essays is confusing <strong>Present Perfect</strong> with <strong>Simple Past</strong>. Use Simple Past when a specific finished time word is present (<em>yesterday, in 2019, ago, last week</em>). NEVER use Present Perfect with specific past dates!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "multiSelectQuiz-5-1",
                    "type": "multiSelectQuiz",
                    "props": {
                        "title": "Select ALL sentences that correctly match tense to time indicators:",
                        "questions": [
                            {
                                "id": "msq1",
                                "question": "Which sentences avoid mixing Present Perfect with specific finished past dates?",
                                "options": [
                                    {
                                        "id": "a",
                                        "text": "He completed the report yesterday.",
                                        "isCorrect": true,
                                        "color": "bg-emerald-500"
                                    },
                                    {
                                        "id": "b",
                                        "text": "He has completed the report yesterday.",
                                        "isCorrect": false,
                                        "color": "bg-rose-500"
                                    },
                                    {
                                        "id": "c",
                                        "text": "They have lived here for five years.",
                                        "isCorrect": true,
                                        "color": "bg-sky-500"
                                    },
                                    {
                                        "id": "d",
                                        "text": "They lived here since 2018.",
                                        "isCorrect": false,
                                        "color": "bg-amber-500"
                                    }
                                ],
                                "explanation": "'Yesterday' specifies a finished past time requiring Simple Past ('completed'). 'Since 2018' requires Present Perfect ('have lived')."
                            }
                        ],
                        "points": 20,
