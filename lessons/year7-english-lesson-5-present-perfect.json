                                "Simple Past (V2)",
                                "Past Participle (V3 - Present Perfect)"
                            ],
                            [
                                "Write",
                                "Wrote",
                                "has / have written"
                            ],
                            [
                                "See",
                                "Saw",
                                "has / have seen"
                            ],
                            [
                                "Finish",
                                "Finished",
                                "has / have finished"
                            ]
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
