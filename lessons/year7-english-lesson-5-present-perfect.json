        {
            "id": "slide-2",
            "title": "Subject Agreement & Past Participles",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-2-1",
                    "type": "heading",
                    "props": {
                        "content": "⚙️ Auxiliary HAS/HAVE & Participle Selection",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-1",
                    "type": "paragraph",
                    "props": {
                        "content": "To construct the Present Perfect correctly, select <strong>HAS</strong> for third-person singular subjects (<em>he, she, it, Maya</em>) and <strong>HAVE</strong> for all other subjects (<em>I, you, we, they</em>). Then append the <strong>Past Participle</strong> (V3).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "table-2-1",
                    "type": "table",
                    "props": {
                        "rows": 4,
                        "columns": 3,
                        "data": [
                            [
