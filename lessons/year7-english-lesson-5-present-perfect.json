                                "right": "Past action with present result or life experience"
                            },
                            {
                                "id": "p2",
                                "left": "Simple Past",
                                "right": "Action completed at a specific finished time"
                            },
                            {
                                "id": "p3",
                                "left": "Past Progressive",
                                "right": "Action in progress at a specific past moment"
                            }
                        ],
                        "shuffled": true,
