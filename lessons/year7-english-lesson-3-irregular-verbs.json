                    "id": "paragraph-2-2",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Key Rule</strong>: Never add -ed to these verbs! Writing <em>'singed'</em> (meaning slightly burned) instead of <em>'sang'</em> changes the meaning completely.",
