        {
            "id": "slide-2",
            "title": "Pattern 1: Vowel Mutations (I -> A -> U)",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-2-1",
                    "type": "heading",
                    "props": {
                        "content": "🎵 Vowel Mutations: The I-A-U Sound Shift",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Many irregular verbs follow a musical vowel shift pattern: the base vowel <strong>i</strong> changes to <strong>a</strong> in the simple past, and to <strong>u</strong> in the past participle.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-2-1",
                    "type": "flashcards",
