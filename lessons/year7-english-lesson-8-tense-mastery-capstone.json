                        "questions": [
                            {
                                "id": "q1",
                                "question": "Which multi-clause sentence correctly sequences Past Perfect (earliest), Past Progressive (ongoing), and Simple Past (interruption)?",
                                "options": [
                                    {
                                        "id": "opt1",
                                        "text": "Although he had lost his map, while he was searching the forest, he found a landmark.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "opt2",
                                        "text": "Although he lost his map, while he had searched the forest, he was finding a landmark.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt3",
                                        "text": "Although he was losing his map, while he found the forest, he had searched a landmark.",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "'Had lost' is the earliest past event, 'was searching' is the ongoing background search, and 'found' is the sudden simple past discovery."
                            },
                            {
                                "id": "q2",
                                "question": "What is the primary role of Past Perfect in complex multi-clause prose?",
                                "options": [
                                    {
                                        "id": "opt1",
                                        "text": "To anchor the earliest past backstory event prior to other past actions",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "opt2",
                                        "text": "To describe an action happening right now in the present",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt3",
                                        "text": "To predict a future event without evidence",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "Past Perfect ('had + V3') serves as the earliest temporal layer."
                            }
                        ],
