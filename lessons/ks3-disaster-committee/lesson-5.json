                        "title": "Selecting High-Urgency Modal Verbs",
                        "questions": [
                            {
                                "id": "q-1",
                                "question": "Which modal verb creates the strongest sense of legal and moral obligation in a speech?",
                                "explanation": "'Must' expresses an imperative, non-negotiable obligation, whereas 'might' or 'should' sound optional.",
                                "options": [
                                    {
                                        "text": "We MUST authorize the evacuation immediately.",
                                        "isCorrect": true
                                    },
                                    {
                                        "text": "We might consider looking at the evacuation plan.",
                                        "isCorrect": false
                                    },
                                    {
                                        "text": "We could perhaps suggest people move uphill.",
                                        "isCorrect": false
                                    }
                                ]
                            },
                            {
                                "id": "q-2",
                                "question": "Which discourse marker introduces a decisive logical conclusion?",
                                "explanation": "'Therefore' logically connects evidence to an undeniable conclusion.",
                                "options": [
                                    {
                                        "text": "Therefore, delay is no longer an option.",
                                        "isCorrect": true
                                    },
                                    {
                                        "text": "Anyway, it might rain later.",
                                        "isCorrect": false
                                    },
                                    {
                                        "text": "By the way, the biscuits are nice.",
                                        "isCorrect": false
                                    }
                                ]
                            }
                        ],
                        "points": 15,
                        "mode": "practice"
