                    "props": {
                        "title": "Match Objections to Concessive Rebuttals",
                        "pairs": [
                            {
                                "id": "p-1",
                                "left": "Vane: 'Yellow Alert costs 50,000 pounds!'",
                                "right": "Rebuttal: 'While municipal funds are limited, repairing flood damage will cost 2 million pounds.'"
                            },
                            {
                                "id": "p-2",
                                "left": "Vane: 'The wall hasn't failed in 140 years!'",
                                "right": "Rebuttal: 'Although the wall has a proud history, today's 1.8m surge is unprecedented.'"
                            },
                            {
                                "id": "p-3",
                                "left": "Vane: 'Citizens might panic needlessly!'",
                                "right": "Rebuttal: 'Granted, panic must be avoided, but clear emergency instructions create calm order.'"
                            }
