        {
            "id": "slide-3",
            "title": "Present Tenses with Future Meaning: Schedules & Arrangements",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-3-1",
                    "type": "heading",
                    "props": {
                        "content": "📅 Present Forms Expressing Future Time",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-3-1",
                    "type": "paragraph",
                    "props": {
                        "content": "In standard English, two present tenses are commonly used to talk about future time: <strong>Present Continuous</strong> (for fixed personal arrangements) and <strong>Simple Present</strong> (for published timetables/schedules).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-3-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Flip cards to master present tenses for future events!",
                        "cards": [
                            {
                                "id": "fc1",
                                "front": "Present Continuous (Fixed Arrangement)",
                                "back": "Example: 'We are hosting a seminar tomorrow at 2:00 PM.' (Personal arrangement with participants)."
                            },
                            {
                                "id": "fc2",
                                "front": "Simple Present (Official Timetable / Schedule)",
                                "back": "Example: 'The shuttle departs at 07:30 AM sharp.' (Public schedule outside personal control)."
                            },
                            {
                                "id": "fc3",
                                "front": "Timetable vs. Personal Plan",
                                "back": "'The museum opens at 9:00 AM' (Timetable) vs 'I am visiting the museum at 10:00 AM' (Personal plan)."
                            }
                        ],
                        "mode": "practice",
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted",
