        {
            "id": "slide-5",
            "title": "Future Time Clauses: Time Words Drop WILL",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-5-1",
                    "type": "heading",
                    "props": {
                        "content": "⚠️ The Future Time Clause Rule: WHEN / AS SOON AS",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-5-1",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Critical Grammar Rule</strong>: In subordinate time clauses introduced by <em>when, as soon as, before, after, until, or if</em>, we NEVER use 'will'. We use the <strong>Simple Present</strong> instead, even though the sentence refers to the future!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "multiSelectQuiz-5-1",
                    "type": "multiSelectQuiz",
                    "props": {
                        "title": "Select ALL sentences that correctly apply the Future Time Clause rule:",
                        "questions": [
                            {
                                "id": "msq1",
                                "question": "Which sentences correctly use Simple Present in the 'when/as soon as' clause?",
                                "options": [
                                    {
                                        "id": "a",
                                        "text": "When the package arrives, I will call you.",
                                        "isCorrect": true,
                                        "color": "bg-emerald-500"
                                    },
                                    {
                                        "id": "b",
                                        "text": "When the package will arrive, I will call you.",
                                        "isCorrect": false,
                                        "color": "bg-rose-500"
                                    },
                                    {
                                        "id": "c",
                                        "text": "As soon as the bell rings, we will leave.",
                                        "isCorrect": true,
                                        "color": "bg-sky-500"
                                    },
                                    {
                                        "id": "d",
                                        "text": "As soon as the bell will ring, we will leave.",
                                        "isCorrect": false,
                                        "color": "bg-amber-500"
                                    }
                                ],
                                "explanation": "Subordinate clauses starting with 'when' or 'as soon as' take Simple Present ('arrives', 'rings'), NOT 'will arrive'."
                            }
                        ],
                        "points": 20,
