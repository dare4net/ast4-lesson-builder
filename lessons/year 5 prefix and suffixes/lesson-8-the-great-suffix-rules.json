                },
                {
                    "id": "callout-ch8-s1",
                    "type": "callout",
                    "props": {
                        "variant": "important",
                        "title": "The 3 Golden Suffix Spelling Rules",
                        "content": "When attaching suffixes, root words sometimes change shape! You must master: 1. Change Y to I, 2. Drop Silent E, and 3. Double the Final Consonant!"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "accordion-ch8-s1",
                    "type": "accordion",
                    "props": {
                        "title": "Inspect the 3 Golden Rules",
                        "allowMultiple": false,
                        "items": [
                            {
                                "id": "acc-ch8-1",
                                "title": "Rule #1: Change Y to I",
                                "content": "If a word ends in a consonant + Y, change Y to I before adding the suffix: 'happy' + '-ness' = 'happiness', 'beauty' + '-ful' = 'beautiful'."
                            },
                            {
                                "id": "acc-ch8-2",
                                "title": "Rule #2: Drop Silent E",
                                "content": "If a word ends in silent E, drop E before a vowel suffix: 'create' + '-tion' = 'creation', 'make' + '-ing' = 'making'."
                            },
                            {
                                "id": "acc-ch8-3",
                                "title": "Rule #3: Double Final Consonant",
                                "content": "For 1-syllable CVC words (Consonant-Vowel-Consonant), double the final consonant before a vowel suffix: 'run' + '-ing' = 'running', 'hop' + '-ed' = 'hopped'."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                }
            ]
        },
