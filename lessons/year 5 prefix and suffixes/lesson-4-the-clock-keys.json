                            {
                                "id": "acc-ch4-1",
                                "title": "Key #1: 'pre-' (BEFORE)",
                                "content": "'pre-' means BEFORE. 'pre-' + 'view' = 'preview' (view before the main show). 'pre-' + 'heat' = 'preheat' (heat before cooking)."
                            },
                            {
                                "id": "acc-ch4-2",
                                "title": "Key #2: 're-' (AGAIN)",
                                "content": "'re-' means AGAIN. 're-' + 'read' = 'reread' (read again). 're-' + 'build' = 'rebuild' (build again)."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
