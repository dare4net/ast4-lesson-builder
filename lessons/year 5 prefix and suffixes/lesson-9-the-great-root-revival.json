                    "props": {
                        "title": "Inspect the 5 Classical Root Families",
                        "allowMultiple": false,
                        "items": [
                            {
                                "id": "acc-ch9-1",
                                "title": "Root #1: STRUCT (Build)",
                                "content": "Latin 'struct' means TO BUILD: 'con-struct' (build together), 'in-struct' (build knowledge into), 'de-struct-ion' (un-building)."
                            },
                            {
                                "id": "acc-ch9-2",
                                "title": "Root #2: VIS / VID (See)",
                                "content": "Latin 'vis/vid' means TO SEE: 'vis-ion' (the act of seeing), 'in-vis-ible' (not able to be seen), 'vid-eo' (recorded sight)."
                            },
                            {
                                "id": "acc-ch9-3",
                                "title": "Root #3: AUD (Hear)",
                                "content": "Latin 'aud' means TO HEAR: 'aud-io' (sound), 'aud-ience' (group of listeners), 'in-aud-ible' (not able to be heard)."
                            },
                            {
                                "id": "acc-ch9-4",
                                "title": "Root #4: TRACT (Pull / Drag)",
                                "content": "Latin 'tract' means TO PULL: 'at-tract' (pull toward), 'dis-tract' (pull away), 'trac-tor' (pulling machine)."
                            },
                            {
                                "id": "acc-ch9-5",
                                "title": "Root #5: DICT (Speak / Say)",
                                "content": "Latin 'dict' means TO SPEAK: 'dict-ate' (speak words for writing), 'pre-dict' (say before), 'dict-ion-ary' (book of spoken words)."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                }
            ]
