                    "status": "uncompleted"
                },
                {
                    "id": "callout-ch6-s1",
                    "type": "callout",
                    "props": {
                        "variant": "important",
                        "title": "Suspect Profile #2 — Wren (The Suffix Sidekick)",
                        "content": "Wren works at the END of words! While the Prefix Bandit alters FRONT meanings, Wren changes what words CAN DO!"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "accordion-ch6-s1",
                    "type": "accordion",
                    "props": {
                        "title": "Inspect Wren's Suffix Stamps",
                        "allowMultiple": false,
                        "items": [
                            {
                                "id": "acc-ch6-1",
                                "title": "Stamp #1: '-ful' (FULL OF)",
                                "content": "'care' + '-ful' = 'careful' (full of care). 'help' + '-ful' = 'helpful' (full of help)."
                            },
                            {
                                "id": "acc-ch6-2",
                                "title": "Stamp #2: '-less' (WITHOUT)",
                                "content": "'care' + '-less' = 'careless' (without care). 'help' + '-less' = 'helpless' (without help)."
                            },
                            {
                                "id": "acc-ch6-3",
                                "title": "Stamp #3: '-able' (ABLE TO BE)",
                                "content": "'wash' + '-able' = 'washable' (able to be washed). 'read' + '-able' = 'readable' (able to be read)."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                }
            ]
