                            {
                                "id": "acc-ch7-1",
                                "title": "'-ment' (Action or Result)",
                                "content": "'govern' (verb) + '-ment' = 'government' (noun - the act or group of governing)."
                            },
                            {
                                "id": "acc-ch7-2",
                                "title": "'-tion' / '-sion' (Process or State)",
                                "content": "'invent' (verb) + '-tion' = 'invention' (noun - the result of inventing)."
                            },
                            {
                                "id": "acc-ch7-3",
                                "title": "'-ness' (State or Quality)",
                                "content": "'kind' (adjective) + '-ness' = 'kindness' (noun - the quality of being kind)."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                }
