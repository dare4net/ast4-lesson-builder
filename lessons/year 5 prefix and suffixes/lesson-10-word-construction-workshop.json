                                "id": "acc-ch10-3",
                                "title": "Blueprint #3: 'DISRESPECTFUL'",
                                "content": "Prefix 'DIS-' (opposite of) + Root 'RESPECT' (regard) + Suffix '-FUL' (full of) = 'disrespectful' (full of no respect)."
                            }
