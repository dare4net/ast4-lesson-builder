                            {
                                "id": "acc-ch10-2",
                                "title": "Blueprint #2: 'RECONSTRUCTION'",
                                "content": "Prefix 'RE-' (again) + Prefix 'CON-' (together) + Root 'STRUCT' (build) + Suffix '-TION' (process) = 'reconstruction' (the process of building together again)."
