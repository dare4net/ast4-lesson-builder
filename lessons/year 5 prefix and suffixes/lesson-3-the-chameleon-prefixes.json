                        "allowMultiple": false,
                        "items": [
                            {
                                "id": "acc-ch3-1",
                                "title": "in- (Default)",
                                "content": "Used before most letters: 'in-' + 'correct' = 'incorrect'."
                            },
                            {
                                "id": "acc-ch3-2",
                                "title": "im- (Before P / M)",
                                "content": "'in-' turns into 'im-' before P or M: 'im-' + 'possible' = 'impossible', 'im-' + 'mature' = 'immature'."
                            },
                            {
                                "id": "acc-ch3-3",
                                "title": "il- (Before L)",
                                "content": "'in-' turns into 'il-' before L: 'il-' + 'legal' = 'illegal'."
                            },
                            {
                                "id": "acc-ch3-4",
                                "title": "ir- (Before R)",
                                "content": "'in-' turns into 'ir-' before R: 'ir-' + 'responsible' = 'irresponsible'."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
