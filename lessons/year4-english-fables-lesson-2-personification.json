                    "id": "paragraph-p-5",
                    "type": "paragraph",
                    "props": {
                        "content": "A key mastery skill is knowing when language is <strong>personified (figurative)</strong> and when it is <strong>literal (plain fact)</strong>. A literal description gives factual information about a thing but does NOT give it a human quality.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
