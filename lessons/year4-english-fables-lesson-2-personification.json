                    "props": {
                        "content": "Writers give non-human things human qualities in three specific ways. Click each zone in the illustration below to discover them all!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "hotspot-p-1",
                    "type": "hotspot",
                    "props": {
                        "title": "Click each zone to discover the 3 types of Personification",
                        "image": "/placeholder.svg?height=380&width=640",
                        "behavior": "discovery",
                        "mode": "practice",
                        "hotspots": [
                            {
                                "id": "hs-p-action",
                                "x": 0.2,
                                "y": 0.4,
                                "label": "Human ACTIONS 🏃",
                                "content": "Type 1 — Human Actions: Giving a non-human thing something only humans or animals DO. Examples: 'The clouds raced across the sky.' / 'The mountain watched the travellers.' / 'The river danced over the pebbles.'"
                            },
                            {
                                "id": "hs-p-emotion",
                                "x": 0.5,
                                "y": 0.65,
                                "label": "Human EMOTIONS ❤️",
                                "content": "Type 2 — Human Emotions: Giving a non-human thing a feeling only humans experience. Examples: 'The angry storm refused to calm.' / 'The shy moon hid behind the clouds.' / 'The joyful flowers nodded in the breeze.'"
                            },
                            {
                                "id": "hs-p-speech",
                                "x": 0.8,
                                "y": 0.35,
                                "label": "Human SPEECH 💬",
                                "content": "Type 3 — Human Speech or Communication: Giving a non-human thing the ability to speak, sing, whisper, or warn. Examples: 'The old oak tree whispered its secrets.' / 'The thunder bellowed its warning across the valley.' / 'The brook sang a gentle lullaby.'"
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
