                            [
                                "The sun produced a lot of heat today.",
                                "The generous sun wrapped the field in a warm golden blanket."
                            ],
                            [
                                "The tree's leaves fell to the ground.",
                                "The tired old tree let its leaves fall with a sigh."
                            ],
                            [
                                "The river runs down the valley.",
