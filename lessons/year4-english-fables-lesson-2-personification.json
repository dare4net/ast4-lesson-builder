                            {
                                "id": "msq-p-1",
                                "question": "Which of these sentences use Personification? Select ALL that apply.",
                                "options": [
                                    {
                                        "id": "ms-p-1",
                                        "text": "The furious waves attacked the helpless boat.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "ms-p-2",
                                        "text": "The lake is 3 kilometres from the village.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "ms-p-3",
                                        "text": "The lonely lighthouse called out into the dark sea.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "ms-p-4",
                                        "text": "The jealous storm cloud swallowed the afternoon sun.",
                                        "isCorrect": true
                                    }
                                ],
                                "explanation": "Three sentences use personification: waves 'attacking' (action), lighthouse 'calling out' (speech), storm cloud 'swallowing jealously' (action + emotion). The distance fact is purely literal."
