        {
            "id": "slide-intro-02",
            "title": "The 4 Storytelling Superpowers",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-intro-2",
                    "type": "heading",
                    "props": {
                        "content": "Meet Your 4 Storytelling Superpowers",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-intro-3",
                    "type": "paragraph",
                    "props": {
                        "content": "Great fable writers don't just tell stories—they paint vivid pictures in your mind using <strong>Figurative Language</strong>! Explore the enchanted scene below to discover the 4 superpowers you will master.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "hotspot-intro-1",
                    "type": "hotspot",
                    "props": {
                        "title": "Interactive Fable Forest: Click the target markers to discover your 4 Superpowers!",
                        "image": "/placeholder.svg?height=400&width=640",
                        "behavior": "explore",
                        "mode": "practice",
                        "hotspots": [
                            {
                                "id": "hs-personification",
                                "x": 0.22,
                                "y": 0.35,
                                "label": "Talking Tree 🌳",
                                "content": "Superpower 1: PERSONIFICATION! Giving human feelings, actions, and speech to animals and nature (e.g. 'The old oak tree whispered secrets to the wind')."
                            },
                            {
                                "id": "hs-simile",
                                "x": 0.55,
                                "y": 0.65,
                                "label": "Speedy Cheetah 🐆",
                                "content": "Superpower 2: SIMILES! Comparing two different things using 'LIKE' or 'AS' (e.g. 'The cheetah ran as fast as lightning')."
                            },
                            {
                                "id": "hs-metaphor",
                                "x": 0.82,
                                "y": 0.25,
                                "label": "Blazing Sun ☀️",
                                "content": "Superpower 3: METAPHORS! Saying one thing IS another thing to create deep imagery (e.g. 'The sun was a golden shield in the sky')."
                            },
                            {
                                "id": "hs-moral",
                                "x": 0.45,
                                "y": 0.82,
                                "label": "Ancient Scroll 📜",
                                "content": "Superpower 4: FABLE MORALS! Uncovering the core wisdom lesson hidden at the conclusion of the story (e.g. 'Slow and steady wins the race')."
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
                {
                    "id": "paragraph-intro-4",
                    "type": "paragraph",
                    "props": {
                        "content": "Flip the discovery cards below to review how each superpower transforms basic writing into magical storytelling!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-intro-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Superpower Preview Cards",
                        "mode": "practice",
                        "cards": [
                            {
                                "id": "card-p",
                                "front": "Superpower 1: Personification",
                                "back": "Giving human qualities to animals, objects, or nature. Example: 'The friendly sun smiled down on the forest.'"
                            },
                            {
                                "id": "card-s",
                                "front": "Superpower 2: Similes",
                                "back": "Comparing two things using the words 'LIKE' or 'AS'. Example: 'He was as brave as a lion.'"
                            },
                            {
                                "id": "card-m",
                                "front": "Superpower 3: Metaphors",
                                "back": "Directly calling one thing another thing without using 'like' or 'as'. Example: 'Her heart was a fortress of courage.'"
                            },
                            {
                                "id": "card-l",
                                "front": "Superpower 4: Fable Morals",
                                "back": "The valuable life lesson woven into a story. Example: 'Kindness is never wasted.'"
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                }
            ]
        },
