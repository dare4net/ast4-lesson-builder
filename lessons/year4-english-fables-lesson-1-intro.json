                        "showExplanation": true,
                        "shuffleOptions": true,
                        "randomizeAnswers": true,
                        "questions": [
                            {
                                "id": "q-warmup-1",
                                "question": "In the phrase 'The moonlight danced across the river', what human action is given to the moonlight?",
                                "options": [
                                    {
                                        "id": "opt-1a",
                                        "text": "Dancing across the river",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "opt-1b",
                                        "text": "Swimming in the water",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt-1c",
                                        "text": "Sleeping on a cloud",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt-1d",
                                        "text": "Eating dinner",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "Dancing is a human action! When we say moonlight 'danced', we are giving nature a human action—that is Personification!"
                            }
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
                {
                    "id": "paragraph-intro-6",
                    "type": "paragraph",
                    "props": {
                        "content": "Now try this multi-select challenge: Which of these descriptions are human qualities applied to non-human things?",
