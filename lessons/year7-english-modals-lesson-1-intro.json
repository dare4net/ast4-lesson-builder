                            {
                                "id": "opt1",
                                "text": "You MUST submit the assignment by 5 PM."
                            },
                            {
                                "id": "opt2",
                                "text": "You SHOULD submit the assignment by 5 PM."
                            },
                            {
                                "id": "opt3",
                                "text": "You COULD submit the assignment by 5 PM."
                            }
                        ],
                        "points": 5
                    }
                }
            ]
        },
        {
            "id": "slide-2",
            "title": "What Are Modal Auxiliary Verbs?",
            "subtitle": "Special Helper Verbs with Unique Rules",
            "layout": "split",
            "components": [
                {
                    "id": "modal-rules-heading",
                    "type": "heading",
                    "props": {
                        "content": "Three Key Characteristics of Modals",
                        "level": 3,
                        "align": "left"
                    }
                },
                {
                    "id": "modal-rules-list",
                    "type": "bulletList",
                    "props": {
                        "items": [
                            "They always partner with a main base verb (e.g., must GO, can SWIM, should READ).",
                            "They never change form (no adding -ed, -ing, or -s).",
                            "They express attitudes such as certainty, obligation, permission, and ability."
                        ],
                        "type": "unordered"
                    }
                },
                {
                    "id": "modal-flashcards-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Core Modal Verbs & Their Roles",
                        "cards": [
                            {
                                "id": "c1",
                                "front": "Must / Shall",
                                "back": "High certainty or mandatory obligation (e.g., 'You must stop.')"
                            },
                            {
                                "id": "c2",
                                "front": "Should / Ought to",
                                "back": "Advice, expectation, or recommendation (e.g., 'You should rest.')"
                            },
                            {
                                "id": "c3",
                                "front": "Might / Could",
                                "back": "Possibility or speculation (e.g., 'It might rain.')"
                            },
                            {
                                "id": "c4",
                                "front": "Can / May",
                                "back": "Ability or formal permission (e.g., 'May I enter?')"
                            }
                        ],
                        "mode": "practice"
                    },
                    "mode": "practice"
                }
            ]
        },
