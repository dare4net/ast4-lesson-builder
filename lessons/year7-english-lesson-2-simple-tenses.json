        {
            "id": "slide-4",
            "title": "Simple Future Tense: Will vs. Going To",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-4-1",
                    "type": "heading",
                    "props": {
                        "content": "🚀 Simple Future: 'Will' vs. 'Be Going To'",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-4-1",
                    "type": "paragraph",
                    "props": {
                        "content": "The <strong>Simple Future Tense</strong> expresses actions that have not yet occurred. In English, there are two primary structures used to form the simple future: <strong>will + base verb</strong> and <strong>is/are going to + base verb</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-4-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Flip to learn when to use 'WILL' versus 'BE GOING TO'!",
                        "cards": [
                            {
                                "id": "fc1",
                                "front": "SPONTANEOUS DECISIONS / PROMISES: 'Will'",
                                "back": "Use 'will' for sudden decisions made on the spot or promises ('I will answer the phone!')."
                            },
                            {
                                "id": "fc2",
                                "front": "PRE-PLANNED INTENTIONS: 'Be Going To'",
                                "back": "Use 'be going to' when a decision or plan was already made before speaking ('We are going to launch tomorrow')."
                            },
                            {
                                "id": "fc3",
                                "front": "FUTURE PREDICTIONS WITH EVIDENCE",
                                "back": "Both can express predictions, but 'going to' is often used when there is present evidence ('Look at those clouds! It is going to rain')."
                            }
                        ],
                        "mode": "practice",
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted",
