        {
            "id": "slide-2",
            "title": "Simple Present Tense: Habits & Timeless Truths",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-2-1",
                    "type": "heading",
                    "props": {
                        "content": "☀️ Simple Present: Expressing Habits & Universal Truths",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-1",
                    "type": "paragraph",
                    "props": {
                        "content": "The <strong>Simple Present Tense</strong> is used for two main purposes: 1) <em>Habits and routines</em> that happen repeatedly, and 2) <em>Universal facts or general truths</em> that are always true.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-2-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Flip the cards to see how Simple Present handles Habits vs. Universal Facts!",
                        "cards": [
                            {
                                "id": "fc1",
                                "front": "HABIT / ROUTINE: 'Leo walks to school every morning.'",
                                "back": "Uses simple present 'walks' because it happens repeatedly every day."
                            },
                            {
                                "id": "fc2",
                                "front": "UNIVERSAL FACT: 'The Earth revolves around the Sun.'",
                                "back": "Uses simple present 'revolves' because it is a permanent scientific truth."
                            },
                            {
                                "id": "fc3",
                                "front": "GENERAL STATE: 'She lives in London.'",
                                "back": "Uses simple present 'lives' for an ongoing general state of being."
                            }
                        ],
                        "mode": "practice",
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
                {
                    "id": "paragraph-2-2",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Structure Rule</strong>: Use the base verb (e.g. <em>write, run</em>) for I/You/We/They, and add <strong>-s or -es</strong> (e.g. <em>writes, runs</em>) for He/She/It. Signal words include <em>always, usually, often, every day, frequently</em>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
