        {
            "id": "slide-3",
            "title": "Interrupted Actions: Combining WHEN and WHILE",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-3-1",
                    "type": "heading",
                    "props": {
                        "content": "⚡ Interrupted Timelines: WHEN vs. WHILE",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-3-1",
                    "type": "paragraph",
                    "props": {
                        "content": "Writers frequently combine the <strong>Past Progressive</strong> (long background action) with the <strong>Simple Past</strong> (short interrupting event) using the conjunctions <strong>WHEN</strong> and <strong>WHILE</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "flashcards-3-1",
                    "type": "flashcards",
                    "props": {
                        "title": "Flip cards to master WHEN vs. WHILE clauses!",
                        "cards": [
                            {
                                "id": "fc1",
                                "front": "WHEN + Simple Past (Interrupting Event)",
                                "back": "Example: 'I was presenting my slides WHEN the power failed.' (Power failing interrupted the presentation)."
                            },
                            {
                                "id": "fc2",
                                "front": "WHILE + Past Progressive (Background Action)",
                                "back": "Example: 'WHILE the technician was fixing the router, the team organized the notes.' (Action in progress)."
                            },
                            {
                                "id": "fc3",
                                "front": "Parallel Past Progressive Actions",
                                "back": "Example: 'WHILE Nina was coding, Alex was testing the user interface.' (Two simultaneous actions)."
                            }
                        ],
                        "mode": "practice",
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted",
                    "mode": "practice"
                },
                {
                    "id": "quiz-3-1",
                    "type": "quiz",
                    "props": {
                        "questions": [
                            {
                                "id": "q1",
                                "question": "Which sentence correctly joins a background continuous action with a sudden interruption?",
                                "options": [
                                    {
                                        "id": "opt1",
                                        "text": "We were observing the chemical reaction when the alarm sounded.",
                                        "isCorrect": true
                                    },
                                    {
                                        "id": "opt2",
                                        "text": "We observed the chemical reaction when the alarm was sounding.",
                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt3",
                                        "text": "We were observing the chemical reaction while the alarm sounded.",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "Use Past Progressive ('were observing') for the long ongoing action and 'WHEN + Simple Past' ('when the alarm sounded') for the sudden interruption."
                            },
                            {
                                "id": "q2",
                                "question": "What tense follows 'WHILE' when describing simultaneous ongoing past events?",
                                "options": [
                                    {
                                        "id": "opt1",
                                        "text": "Past Progressive (was/were + -ing)",
                                        "isCorrect": true
                                    },
                                    {
