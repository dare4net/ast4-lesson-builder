                                "left": "Ongoing Past Action",
                                "right": "The storm was howling for hours."
                            },
                            {
                                "id": "p3",
                                "left": "Habitual Present Action",
                                "right": "Storms frequently blow across the coast."
                            }
                        ],
                        "shuffled": true,
