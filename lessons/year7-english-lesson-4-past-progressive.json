                                        "isCorrect": false
                                    },
                                    {
                                        "id": "opt3",
                                        "text": "Future Continuous",
                                        "isCorrect": false
                                    }
                                ],
                                "explanation": "'While' introduces continuous duration, which requires the Past Progressive tense."
                            }
                        ],
                        "showExplanation": true,
