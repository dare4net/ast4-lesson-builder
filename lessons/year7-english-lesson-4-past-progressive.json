        {
            "id": "slide-5",
            "title": "Stative Verbs Warning: Verbs That CANNOT Be Continuous",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-5-1",
                    "type": "heading",
                    "props": {
                        "content": "🚫 Stative Verbs: The Non-Continuous Trap",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-5-1",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Stative Verbs</strong> describe states of mind, feelings, possession, or perception (e.g. <em>know, believe, understand, love, own, belong</em>). Because they are not physical actions, they are <strong>NEVER used in continuous -ing tenses</strong>!",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "multiSelectQuiz-5-1",
                    "type": "multiSelectQuiz",
                    "props": {
                        "title": "Select ALL grammatically correct sentences that avoid stative verb errors:",
                        "questions": [
                            {
                                "id": "msq1",
                                "question": "Which sentences correctly use Simple Past instead of ungrammatical Stative Continuous?",
                                "options": [
                                    {
                                        "id": "a",
                                        "text": "I knew the answer to the quiz question.",
                                        "isCorrect": true,
                                        "color": "bg-emerald-500"
                                    },
                                    {
                                        "id": "b",
                                        "text": "I was knowing the answer to the quiz question.",
                                        "isCorrect": false,
                                        "color": "bg-rose-500"
                                    },
                                    {
                                        "id": "c",
                                        "text": "She owned the antique microscope.",
                                        "isCorrect": true,
                                        "color": "bg-sky-500"
                                    },
                                    {
                                        "id": "d",
                                        "text": "She was owning the antique microscope.",
                                        "isCorrect": false,
                                        "color": "bg-amber-500"
                                    }
                                ],
                                "explanation": "'Know' and 'own' are stative verbs. Forms like 'was knowing' or 'was owning' are incorrect in standard English."
                            }
                        ],
                        "points": 20,
