        {
            "id": "slide-2",
            "title": "Subject-Auxiliary Agreement: WAS vs. WERE",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-2-1",
                    "type": "heading",
                    "props": {
                        "content": "⚖️ Auxiliary Agreement: Was vs. Were",
                        "level": 2,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-1",
                    "type": "paragraph",
                    "props": {
                        "content": "To form the Past Progressive correctly, you must match the auxiliary helping verb (<strong>was</strong> or <strong>were</strong>) to your subject pronoun or noun.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "table-2-1",
                    "type": "table",
                    "props": {
                        "rows": 3,
                        "columns": 3,
                        "data": [
                            [
                                "Subject Type",
                                "Auxiliary Verb",
                                "Example Sentence"
                            ],
                            [
                                "Singular (I, He, She, It, Maya)",
                                "WAS",
                                "He was studying in the library."
                            ],
                            [
                                "Plural & You (You, We, They, Students)",
                                "WERE",
                                "They were analyzing the manuscript."
                            ]
                        ]
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-2-2",
                    "type": "paragraph",
                    "props": {
                        "content": "<strong>Special Rule for 'YOU'</strong>: Even when <em>you</em> refers to a single individual, it ALWAYS takes the plural auxiliary <strong>were</strong> (e.g. <em>'You were standing near the doorway'</em>, NEVER <em>'You was'</em>).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "fillInTheBlank-2-1",
