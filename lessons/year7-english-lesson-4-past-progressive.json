    "slides": [
        {
            "id": "slide-1",
            "title": "Introduction: What is the Past Progressive Tense?",
            "status": "uncompleted",
            "state": "active",
            "components": [
                {
                    "id": "heading-1-1",
                    "type": "heading",
                    "props": {
                        "content": "⏳ The Past Progressive: Actions in Motion",
                        "level": 1,
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-1-1",
                    "type": "paragraph",
                    "props": {
                        "content": "While the Simple Past describes a completed action at a specific time (<em>'I ate lunch'</em>), the <strong>Past Progressive</strong> (also called Past Continuous) shows an action that was ongoing or unfolding in the background of the past. Formula: <strong>WAS / WERE + VERB-ING</strong>.",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "poll-1-1",
                    "type": "poll",
                    "props": {
                        "question": "Which sentence describes an ONGOING action unfolding in the past?",
                        "options": [
                            {
                                "id": "opt1",
                                "text": "At 8:00 PM, she was reading a mystery novel."
                            },
                            {
                                "id": "opt2",
                                "text": "She read a mystery novel yesterday."
                            },
                            {
                                "id": "opt3",
                                "text": "She reads mystery novels every weekend."
                            }
                        ],
                        "points": 5,
                        "state": "active"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "paragraph-1-2",
                    "type": "paragraph",
                    "props": {
                        "content": "The Past Progressive focuses on the duration or activity in progress at a specific temporal reference point (e.g. <em>'At midnight, rain was pouring outside'</em>).",
                        "align": "left"
                    },
                    "state": "active",
                    "status": "uncompleted"
                },
                {
                    "id": "matchingPairs-1-1",
                    "type": "matchingPairs",
