# Shared with the Express API. Must match afterschool-tech-backend JWT_SECRET.
JWT_SECRET=

# Express API root, including /api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Optional error reporting
NEXT_PUBLIC_SENTRY_DSN=

# Required for image and audio uploads (Next.js API routes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_MAX_WIDTH=1600
CLOUDINARY_THUMBNAIL_MAX_WIDTH=800

# Optional. Lesson interactions now live on Express; only leftover local scripts need this.
MONGODB_URI=
