# Shared with the Express API. Must match afterschool-tech-backend JWT_SECRET.
JWT_SECRET=

# Express API root, including /api
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Optional error reporting
NEXT_PUBLIC_SENTRY_DSN=

# Firebase Cloud Messaging (web push). From Firebase Console → Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Required for image and audio uploads (Next.js API routes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_IMAGE_MAX_WIDTH=1600
CLOUDINARY_THUMBNAIL_MAX_WIDTH=800

# Optional. Lesson interactions now live on Express; only leftover local scripts need this.
MONGODB_URI=
